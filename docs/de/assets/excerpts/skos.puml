@startuml
!pragma layout smetana
skinparam shadowing false
skinparam roundCorner 10
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam Padding 3
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2
skinparam classBorderColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageBackgroundColor #F4F4F4
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam legendBorderColor #999999
skinparam legendBackgroundColor #FFFFFF
skinparam legendFontSize 11
hide circle
hide empty members
package "Referenzdaten" as REF {
  class "Kontrollpunkt" as KP {
    schema:identifier : xsd:string
    skos:notation : xsd:string [0..1]
    schema:name : rdf:langString [1..*]
    schema:description : rdf:langString [1..*]
    schema:validFrom : xsd:date [0..1]
    schema:validThrough : xsd:date [0..1]
  }
  class "Gliederungselement" as KZ <<skos:Concept>>
  class "Kontrollpunktkatalog" as KAT <<skos:ConceptScheme>> {
    schema:name : rdf:langString [1..*]
    schema:datePublished : xsd:date
    schema:validFrom : xsd:date
    schema:validThrough : xsd:date [0..1]
  }
  class "Fokuskontrollpunkte" as FKP <<skos:Collection>>
}
KAT "1" *-down- "0..1" FKP
KP "1..*" -up-> "1..*" KAT : skos:inScheme
FKP "0..*" -down-> "1..*" KP : skos:member
KP "0..*" -down-> "1" KZ : zugeordnet
KZ --> KZ : skos:broader [0..1]
@enduml
