@startuml
!pragma layout smetana
skinparam shadowing false
skinparam roundCorner 10
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam Padding 3
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2
skinparam classBorderColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageBackgroundColor #F4F4F4
hide circle
hide empty members
package "Referenzdaten" as REF {
  class "Organisation" as ORG
  class "Regelwerk" as RW
  class "Anforderung" as ANF
  class "Kontrollpunkt" as KP
}
RW -up-> ORG : erlassen von
ANF -up-> RW : stammt aus
KP -up-> ANF : prüft
KP -up-> ORG : herausgegeben von
@enduml
