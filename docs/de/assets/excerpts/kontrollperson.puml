@startuml
!pragma layout smetana
skinparam shadowing false
skinparam roundCorner 10
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam Padding 3
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2
skinparam classBorderColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageBackgroundColor #F4F4F4
hide circle
hide empty members
package "Referenzdaten" as REF {
  class "Organisation" as ORG
  class "Kontrollperson" as PER
  class "Qualifikation" as QUA
}
package "Transaktionsdaten" as TRX {
  class "Kontrolle" as KON
  class "Tatsächliche\nBeobachtung" as BEO
}
PER -up-> ORG : gehört an
PER --> QUA : besitzt
KON *-down- BEO : enthält
KON -up-> ORG : durchgeführt von\n(Kontrollstelle)
KON -up-> PER : durchgeführt von
BEO -up-> PER : festgestellt von
@enduml
