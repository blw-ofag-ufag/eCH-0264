' Logisches Datenmodell von eCH-0264 (Umsetzung in RDF) (handgezeichnet, wird via Makefile nach docs/de/assets/img/ gerendert (SVG))
' Pakete: Referenzdaten und Transaktionsdaten (Kontrolldaten, die zwischen den Systemen fliessen).
' Stammdaten werden nicht modelliert; die Kontrolle verweist mit Identifikatoren (BUR-Nummer, UID) auf sie.
@startuml
!pragma layout smetana
skinparam shadowing false
skinparam roundCorner 10
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam Padding 3
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2
skinparam classBorderColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageBackgroundColor #F4F4F4
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam legendBorderColor #999999
skinparam legendBackgroundColor #FFFFFF
skinparam legendFontSize 11
hide circle
hide empty members

package "Referenzdaten" as REF {
  class "Organisation" as ORG {
    uid : xsd:string
    schema:name : rdf:langString [1..*]
  }
  class "Kontrollperson" as PER
  class "Identifikator" as PID <<schema:PropertyValue>> {
    schema:value : xsd:string
  }
  class "Qualifikation" as QUA {
    schema:name : rdf:langString [1..*]
  }
  class "Qualifikationsnachweis" as QN {
    schema:validFrom : xsd:date
    schema:validThrough : xsd:date [0..1]
  }
  class "Regelwerk" as RW {
    schema:name : rdf:langString [1..*]
    fassung : xsd:date
    rechtsnatur : Rechtsnatur
    schema:url : xsd:anyURI [0..1]
  }
  enum "Rechtsnatur" as RN <<enumeration>> {
    öffentlich-rechtlich
    privatrechtlich
  }
  class "Anforderung" as ANF {
    schema:description : rdf:langString [1..*]
    fundstelle : xsd:string [0..1]
  }
  class "Programm" as PRG {
    schema:name : rdf:langString [1..*]
    schema:identifier : xsd:string [0..1]
  }
  class "Kontrollpunktkatalog" as KAT <<skos:ConceptScheme>> {
    schema:name : rdf:langString [1..*]
    schema:datePublished : xsd:date
    schema:validFrom : xsd:date
    schema:validThrough : xsd:date [0..1]
  }
  class "Fokuskontrollpunkte" as FKP <<skos:Collection>>
  class "Gliederungselement" as KZ <<skos:Concept>>
  class "Kontrollpunkt" as KP {
    schema:identifier : xsd:string
    skos:notation : xsd:string [0..1]
    schema:name : rdf:langString [1..*]
    schema:description : rdf:langString [1..*]
    schema:validFrom : xsd:date [0..1]
    schema:validThrough : xsd:date [0..1]
  }
  class "Mögliches Ergebnis" as ERG {
    wert : Ergebniswert
    schema:description : rdf:langString [0..*]
    mengeneinheit : xsd:string [0..1]
  }
  enum "Ergebniswert" as ERGW <<enumeration>> {
    ...
  }

  ' Herkunft: Organisation erlässt Regelwerk, Regelwerk enthält Anforderungen
  RW "0..*" -up-> "1" ORG : erlassen von
  RW -right-> RN
  ANF "1..*" -up-> "1" RW : stammt aus

  ' Programm: bündelt Anforderungen, zu deren Einhaltung sich ein Betrieb mit der Anmeldung verpflichtet
  PRG "0..*" -up-> "1" RW : festgelegt in
  PRG "0..*" --> "1..*" ANF : umfasst

  ' Kontrollpunkt prüft Anforderungen und wird von einer Organisation herausgegeben
  KP "0..*" -up-> "1..*" ANF : prüft
  KP "0..*" -up-> "1" ORG : herausgeberin

  ' Jährliche Ausgabe: Katalog mit gültigen Kontrollpunkten und Auswahl der Fokuskontrollpunkte
  KAT "0..*" --> "1" ORG : herausgeberin
  KP "1..*" --> "1..*" KAT : skos:inScheme
  KAT "1" *-- "0..1" FKP
  FKP "0..*" --> "1..*" KP : skos:member

  ' Gliederung: Gliederungselemente sind über skos:broader beliebig tief verschachtelt
  ' (z. B. Kontrollbereich > Rubrik > Gruppe)
  KZ "0..*" --> "0..1" KZ : skos:broader
  KP "0..*" --> "1" KZ : zugeordnet

  ' Ersetzung: ein neuer Kontrollpunkt ersetzt einen oder mehrere frühere Kontrollpunkte
  KP "0..*" --> "0..*" KP : dcterms:replaces
  note right of KP
    Ersetzender und ersetzter
    Kontrollpunkt haben dieselbe
    Herausgeberin (SHACL-Regel).
  end note

  note right of ANF
    Alle Anforderungen, die ein Kontrollpunkt
    prüft, stammen aus Regelwerken mit
    derselben Rechtsnatur (SHACL-Regel).
  end note

  ' Qualifikation: Kontrollpunkt erfordert Qualifikation, Kontrollperson weist sie mit Gültigkeit nach
  KP "0..*" -right-> "0..*" QUA : erfordert
  QUA "0..*" -left-> "0..1" RW : festgelegt in
  PER "0..*" -up-> "1..*" ORG : gehört an

  ' Identifikator: nur zusammen mit der vergebenden Organisation eindeutig
  PER "1" *-- "1..*" PID : schema:identifier
  PID "0..*" -up-> "1" ORG : schema:propertyID
  note bottom of PID
    schema:propertyID verweist auf die Organisation,
    die den Identifikator vergibt. Der Wert ist
    innerhalb dieser Organisation eindeutig (SHACL-Regel).
  end note
  PER "1" *-- "0..*" QN : besitzt
  QN "0..*" --> "1" QUA : qualifikation

  KP -left-> "1..*" ERG : möglich
  ERG -left-> ERGW
}

package "Transaktionsdaten" as TRX {
  ' Verweise auf Stammdaten über Identifikatoren
  class "Anmeldung" as ANM {
    oertlicheEinheit : xsd:string
    rechtlicheEinheit : xsd:string
    beitragsjahr : xsd:gYear
    angemeldetAm : xsd:date
  }
  class "Kontrolle" as KON {
    datum : xsd:date
    oertlicheEinheit : xsd:string
    rechtlicheEinheit : xsd:string
  }
  class "Tatsächliche Beobachtung" as BEO {
    wert : Ergebniswert
    bild : xsd:anyURI [0..1]
    abweichung : rdf:langString [0..1]
    menge : xsd:decimal [0..1]
  }
  KON "1" *-down- "0..*" BEO : enthält
  ANM "0..*" -up-> "1" PRG : für
  ' Korrektur: berichtigt eine falsch erfasste Beobachtung, die nicht mehr gilt
  BEO "0..1" --> "0..1" BEO : prov:wasRevisionOf
  ' Folgebeobachtung: z. B. Nachkontrolle oder abschliessende Beurteilung; die frühere bleibt gültig
  BEO "0..*" --> "0..1" BEO : folgtAuf
}

BEO -up-> KP
BEO "0..*" -up-> "0..1" ERG : festgestelltes Ergebnis
note bottom of BEO
  Ist der Wert «Mangel», ist ein vordefinierter
  Mangel oder eine Abweichung angegeben (SHACL-Regel).
end note
KON "0..*" -up-> "0..1" ORG : kontrollstelle
KON "0..*" -up-> "1..*" PER : durchgeführt von
BEO "0..*" -up-> "1" PER : festgestellt von
REF -[hidden]down- TRX

legend bottom right
  <b>Kardinalitäten</b>
  |= Angabe |= Bedeutung |
  | 1 | genau eins |
  | 0..1 | keins oder eins (optional) |
  | 0..* | keins, eins oder beliebig viele |
  | 1..* | mindestens eins |
  Bei Attributen in eckigen Klammern, z. B. <i>bild : xsd:anyURI [0..1]</i>;
  ohne Angabe gilt 1.
  Merkmale ohne Präfix werden im Namensraum von eCH-0264 definiert.
endlegend
@enduml
