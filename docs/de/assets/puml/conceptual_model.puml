' Konzeptionelles Datenmodell von eCH-0264 (handgezeichnet, wird via Makefile nach docs/de/assets/img/ gerendert (SVG))
' Pakete: Referenzdaten und Transaktionsdaten (Kontrolldaten, die zwischen den Systemen fliessen).
' Stammdaten werden nicht modelliert; die Kontrolle verweist mit Identifikatoren (BUR-Nummer, UID) auf sie.
@startuml
!pragma layout smetana
skinparam shadowing false
skinparam roundCorner 10
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam Padding 3
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2
skinparam classBorderColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageBackgroundColor #F4F4F4
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam legendBorderColor #999999
skinparam legendBackgroundColor #FFFFFF
skinparam legendFontSize 11
hide circle
hide empty members

package "Referenzdaten" as REF {
  class "Anforderung" as ANF {
    grundlage : Text
  }
  class "Kontrollbereich" as KB
  class "Rubrik" as RUB {
    kontrollgrund : Text [0..*]
  }
  class "Gruppe" as GRP
  class "Kontrollpunkt" as KP {
    pointID : UUID
    name : Text 
    beschreibung : Text
  }
  class "Mögliches Ergebnis" as ERG {
    wert : Ergebniswert
  }
  enum "Ergebniswert" as ERGW <<enumeration>> {
    ...
  }

  ' Gliederung: Kontrollbereich > Rubrik > Gruppe (beliebig tief) > Kontrollpunkt;
  ' ein Kontrollpunkt kann auch direkt in einer Rubrik liegen
  KB "1" *-- "0..*" RUB
  RUB "0..1" *-- "0..*" GRP
  GRP "0..1" *-- "0..*" GRP : Untergruppe
  RUB "0..1" *-- "0..*" KP
  GRP "0..1" *-- "0..*" KP

  ANF --> KP
  KP -right-> "1..*" ERG : möglich
  ERG -right-> ERGW
}

package "Transaktionsdaten" as TRX {
  ' Verweise auf Stammdaten über Identifikatoren
  class "Kontrolle" as KON {
    datum : Datum
    kontrollperson : Text [0..1]
    kontrollstelle : Text [0..1]
    oertlicheEinheit : BUR-Nr.
    rechtlicheEinheit : UID
  }
  class "Tatsächliche Beobachtung" as BEO {
    pointID : UUID
    wert : Ergebniswert
    bild : Bild [0..1]
    abweichung : Text [0..1]
  }
  KON "1" *-right- "0..*" BEO : enthält
}

BEO -up-> KP
BEO -up-> ERG : Ergebnis
REF -[hidden]down- TRX

legend bottom right
  <b>Kardinalitäten</b>
  |= Angabe |= Bedeutung |
  | 1 | genau eins |
  | 0..1 | keins oder eins (optional) |
  | 0..* | keins, eins oder beliebig viele |
  | 1..* | mindestens eins |
  Bei Attributen in eckigen Klammern, z. B. <i>bild : Bild [0..1]</i>;
  ohne Angabe gilt 1.
endlegend
@enduml
