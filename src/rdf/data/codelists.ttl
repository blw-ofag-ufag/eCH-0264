    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "08" ;
    schema:name "Biodiversitätsförderflächen"@de,
        "Surfaces de promotion de la biodiversité"@fr,
        "Superfici per la promozione della biodiversità"@it .

domain:OrganicFarming a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
