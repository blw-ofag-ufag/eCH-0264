# ==============================================================================
# CODE LISTS OF eCH-0264
# ------------------------------------------------------------------------------
# Every code list is a skos:ConceptScheme. Its values are instances of a
# dedicated subclass of skos:Concept (see src/rdf/ontology/model.owl.ttl) and
# are validated by the shapes in src/rdf/shapes/model.shacl.ttl.
#
# Lists marked as "Entwurf" in their description are proposals of the working
# group and still need to be aligned with the Acontrol Merkmalskatalog.
# ==============================================================================

# Project-specific namespaces/qnames
@prefix eCH-0264:        <https://agriculture.ld.admin.ch/eCH-0264/1/> .
@prefix domain:          <https://agriculture.ld.admin.ch/eCH-0264/1/inspection-domain/> .
@prefix result:          <https://agriculture.ld.admin.ch/eCH-0264/1/result-value/> .
@prefix reason:          <https://agriculture.ld.admin.ch/eCH-0264/1/inspection-reason/> .
@prefix modality:        <https://agriculture.ld.admin.ch/eCH-0264/1/inspection-modality/> .
@prefix method:          <https://agriculture.ld.admin.ch/eCH-0264/1/assessment-method/> .
@prefix legalnature:     <https://agriculture.ld.admin.ch/eCH-0264/1/legal-nature/> .
@prefix inspstatus:      <https://agriculture.ld.admin.ch/eCH-0264/1/inspection-status/> .
@prefix measuretype:     <https://agriculture.ld.admin.ch/eCH-0264/1/measure-type/> .
@prefix conformity:      <https://agriculture.ld.admin.ch/eCH-0264/1/conformity-status/> .
@prefix certstatus:      <https://agriculture.ld.admin.ch/eCH-0264/1/certificate-status/> .

# Globally used namespaces/qnames
@prefix schema:          <http://schema.org/> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .

# ==============================================================================
# KONTROLLBEREICH (INSPECTION DOMAIN)
# Source: Acontrol data products on agridata.ch (codes and names DE/FR/IT)
# ==============================================================================

domain:ConceptScheme a skos:ConceptScheme ;
    schema:name "Kontrollbereiche"@de,
        "Inspection domains"@en ;
    schema:description "Oberste Gliederungsebene der öffentlich-rechtlichen Kontrollpunkte. Die Codes entsprechen den Kontrollbereichen von Acontrol, nach denen auch die Acontrol-Datenprodukte auf agridata.ch gegliedert sind."@de .

domain:FoodSafetyPlantPrimaryProduction a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "01" ;
    schema:name "Lebensmittelsicherheit (pflanzliche Primärproduktion)"@de,
        "Sécurité alimentaire (production primaire végétale)"@fr,
        "Sicurezza alimentare (produzione primaria vegetale)"@it ;
    skos:scopeNote "Der Code 01 wird in Acontrol für die pflanzliche und die tierische Primärproduktion verwendet. Die beiden Bereiche werden deshalb über ihre IRI unterschieden."@de .

domain:FoodSafetyAnimalPrimaryProduction a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "01" ;
    schema:name "Lebensmittelsicherheit (tierische Primärproduktion)"@de,
        "Sécurité alimentaire (production primaire animale)"@fr,
        "Sicurezza alimentare (produzione primaria animale)"@it ;
    skos:scopeNote "Der Code 01 wird in Acontrol für die pflanzliche und die tierische Primärproduktion verwendet. Die beiden Bereiche werden deshalb über ihre IRI unterschieden."@de .

domain:AnimalHealth a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "02" ;
    schema:name "Tiergesundheit"@de,
        "Santé animale"@fr,
        "Salute degli animali"@it .

domain:AnimalWelfareProtection a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "03" ;
    schema:name "Tierschutz"@de,
        "Protection des animaux"@fr,
        "Protezione degli animali"@it .

domain:Environment a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "04" ;
    schema:name "Umwelt"@de ;
    skos:scopeNote "In der Liste der auf agridata.ch angebotenen Acontrol-Datenprodukte (Stand 2026) nicht enthalten."@de .

domain:GeneralContributionRequirements a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "05" ;
    schema:name "Allgemeine Beitragsvoraussetzungen – Ganzjahres- und Sömmerungsbetriebe"@de,
        "Conditions générales pour l'obtention des contributions – exploitations à l'année et exploitations d'estivage"@fr,
        "Condizioni generali per i contributi – aziende gestite tutto l'anno e d'estivazione"@it .

domain:StructuralData a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "06" ;
    schema:name "Strukturdaten – Ganzjahresbetriebe (DZV und EKBV)"@de,
        "Données sur les structures – exploitations à l'année"@fr,
        "Dati strutturali – aziende gestite tutto l'anno"@it .

domain:ProofOfEcologicalPerformance a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "07" ;
    schema:name "Ökologischer Leistungsnachweis ÖLN"@de,
        "Prestations écologiques requises"@fr,
        "Prova che le esigenze ecologiche sono rispettate"@it ;
    skos:scopeNote "Gemäss Datenproduktbeschreibung ohne Tierschutz, der im Kontrollbereich 03 geführt wird."@de .

domain:BiodiversityPromotionAreas a eCH-0264:InspectionDomain ;
