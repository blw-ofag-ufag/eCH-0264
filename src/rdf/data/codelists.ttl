    schema:identifier "09" ;
    schema:name "Biologische Landwirtschaft"@de,
        "Agriculture biologique"@fr,
        "Agricoltura biologica"@it .

domain:ExtensiveProduction a eCH-0264:InspectionDomain ;
    skos:inScheme domain:ConceptScheme ;
    skos:topConceptOf domain:ConceptScheme ;
    schema:identifier "10" ;
    schema:name "Extensive Produktion"@de ;
    skos:scopeNote "In der Liste der auf agridata.ch angebotenen Acontrol-Datenprodukte (Stand 2026) nicht enthalten."@de .

domain:GrasslandBasedProduction a eCH-0264:InspectionDomain ;
